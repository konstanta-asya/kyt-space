# Локальна БД у Docker (за замовчуванням)
DATABASE_URL=postgresql://kyt:kyt@db:5432/kyt_space
# Спільна тестова БД на Neon — див. README, розділ «База даних: локально або Neon».
# Пряма адреса (без -pooler у хості) + sslmode=require:
# DATABASE_URL=postgresql://<user>:<password>@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
